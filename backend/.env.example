# Copy this file to .env and fill in the values.
# Never commit .env to source control — it contains database credentials.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# PostgreSQL connection string (asyncpg driver).
# Get this from your Neon project dashboard: Settings → Connection string
# Select "Python" and "asyncpg" in the dropdown to get the correct format.
# Example: postgresql+asyncpg://alice:secret@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ---------------------------------------------------------------------------
# OPTIONAL — defaults are shown
# ---------------------------------------------------------------------------

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS allowed origins for the frontend.
# In production, replace * with your actual frontend URL.
# Example: https://job-pipeline.netlify.app
CORS_ORIGINS=*

# Whether the background scheduler should run automatically.
# Set to false if you only want to trigger runs manually.
SCHEDULER_ENABLED=true

# How often to poll the Remotive RSS feed (minimum recommended: 30).
# Lower values risk being rate-limited; the feed does not update that frequently.
REMOTIVE_INTERVAL_MINUTES=30

# Minimum seconds between manual trigger calls for the same adapter.
# Prevents accidental double-triggers from the demo UI.
TRIGGER_COOLDOWN_SECONDS=60

# HTTP timeout in seconds — connect phase
FETCH_TIMEOUT_CONNECT=5.0

# HTTP timeout in seconds — waiting for full response body
FETCH_TIMEOUT_READ=10.0

# How many times to retry a failed request (after the initial attempt)
FETCH_MAX_RETRIES=3

# How many consecutive adapter failures trip the circuit breaker to OPEN
CIRCUIT_FAILURE_THRESHOLD=5

# How many seconds the circuit stays OPEN before attempting a probe request
CIRCUIT_OPEN_WAIT_SECONDS=300
